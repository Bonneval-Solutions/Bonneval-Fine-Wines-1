# Prismic
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=bonneval-fine-wines
# Required — the repo API is private. Prismic → Settings → API & Security → Permanent access token.
PRISMIC_ACCESS_TOKEN=
# Shared secret of the "Vercel revalidate" webhook (Prismic → Settings → Webhooks).
# If set, /api/revalidate rejects POSTs whose body `secret` does not match.
PRISMIC_WEBHOOK_SECRET=

# Public site URL (sitemap / robots)
NEXT_PUBLIC_SITE_URL=https://bonnevalfinewines.com

# Cloudflare Turnstile — https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Brevo — https://app.brevo.com/settings/keys/api
# Do not use BFW-LP-Inbound (3) — that list is for the landing page only.
BREVO_API_KEY=
BREVO_LIST_ID=4
BREVO_CALLBACKS_LIST_ID=5

# Supabase (wired in config; not used by forms while DB is down)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
