{
  "id": "domaines_list",
  "type": "SharedSlice",
  "name": "DomainesList",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "Two-column domaine cards with image left, details right",
      "imageUrl": "https://images.prismic.io/slice-machine/621a5ec4-0387-4bc5-9860-2dd46cbc07cd_default_ss.png?auto=compress,format",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": "The portfolio"
          }
        },
        "headline": {
          "type": "Text",
          "config": {
            "label": "Headline",
            "placeholder": "The ten houses of Bonneval"
          }
        },
        "source": {
          "type": "Select",
          "config": {
            "label": "Source",
            "default_value": "Manual",
            "options": [
              "Manual",
              "All domaines"
            ]
          }
        }
      },
      "items": {
        "domaine": {
          "type": "Link",
          "config": {
            "label": "Domaine",
            "select": "document",
            "customtypes": [
              "domaine"
            ]
          }
        },
        "card_image": {
          "type": "Image",
          "config": {
            "label": "Card Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "name": {
          "type": "Text",
          "config": {
            "label": "Name",
            "placeholder": "Domaine Leroy"
          }
        },
        "appellation": {
          "type": "Text",
          "config": {
            "label": "Appellation",
            "placeholder": "Vosne-Romanée"
          }
        },
        "color": {
          "type": "Select",
          "config": {
            "label": "Colour",
            "options": [
              "rouge",
              "blanc"
            ]
          }
        },
        "descriptor": {
          "type": "Text",
          "config": {
            "label": "Descriptor",
            "placeholder": "Short description"
          }
        }
      }
    }
  ],
  "description": "2x5 card grid with image and domaine details"
}